# Deployment environment for gitea-mcp-oauth (OAuth mode).
# Copy to .env (git-ignored), chmod 600, and fill in your values.
# No secret values belong in this file: secrets are files (see below).

# Container image, pinned by tag (never 'latest')
GITEA_MCP_IMAGE=git.example.com/username/gitea-mcp-oauth:v0.1.1

# Host binding: localhost only, the reverse proxy terminates TLS
HOST_BIND=127.0.0.1
HOST_PORT=3040

# Public base URL of your Gitea instance
GITEA_HOST=https://git.example.com

# Client ID of the Gitea OAuth2 app (confidential, redirect https://mcp.example.com/oauth/callback)
GITEA_OAUTH_CLIENT_ID=your-gitea-oauth-client-id

# Public URL of gitea-mcp-oauth (https://, no path)
GITEA_OAUTH_PUBLIC_URL=https://mcp.example.com

# The single Gitea login allowed to authorize
GITEA_OAUTH_ALLOWED_USER=your-gitea-username

# Client redirect URIs allowed at registration (comma-separated, exact values, no wildcards).
# Always set explicitly. Claude uses the two URIs below.
# ChatGPT: new connectors show a per-connector URI https://chatgpt.com/connector/oauth/{callback_id}
# on their setup page; append that exact value when you add the connector, then restart.
GITEA_OAUTH_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback,https://chatgpt.com/connector/oauth/<your url>

# Secret files on the host, relative to the deployment directory
GITEA_OAUTH_CLIENT_SECRET_FILE=./client.secret
GITEA_OAUTH_SIGNING_KEY_FILE=./signing.key
